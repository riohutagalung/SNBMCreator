# SNBM Creator — Supabase target configuration
# Do not commit real values. Copy these variable names into Hostinger hPanel.
NODE_ENV=production
PORT=3000
SITE_URL=https://snbmcreator.com

# Public, embedded into browser bundles by Vite. Publishable key only.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Hostinger SSR / server-only action environment.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# PRIVILEGED: keep in hPanel Node.js application environment ONLY.
# Never use this with a VITE_ prefix. Rotate the previously exposed key.
SUPABASE_SECRET_KEY=replace-with-new-secret-key
