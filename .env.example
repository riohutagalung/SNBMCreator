# Web app
NODE_ENV=production
PORT=3000
SITE_URL=https://snbmcreator.com

# Browser-visible PocketBase API URL.
# Set this to a public HTTPS endpoint such as https://api.snbmcreator.com.
VITE_POCKETBASE_URL=https://api.snbmcreator.com

# Server-to-server PocketBase URL; keep private.
POCKETBASE_URL=http://127.0.0.1:8090

# PocketBase superuser for server-side web operations.
# Use credentials different from the website admin account.
PB_SUPERUSER_EMAIL=replace-with-superuser-email
PB_SUPERUSER_PASSWORD=replace-with-long-random-password

# Website admin account seeded by the SNBM Creator admin migration.
SNBM_ADMIN_EMAIL=replace-with-admin-email
SNBM_ADMIN_PASSWORD=replace-with-different-long-random-password

# Persistent PocketBase encryption key. Never rotate it without following PB backup/restore guidance.
PB_ENCRYPTION_KEY=replace-with-long-random-encryption-key
